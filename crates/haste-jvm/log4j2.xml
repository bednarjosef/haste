<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for tier-3 vanilla code in Haste's JVM: warnings and errors to stderr, no log files
     (vanilla's own configuration writes logs/ into the working directory). -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Stderr" target="SYSTEM_ERR">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger{1}]: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="warn">
            <AppenderRef ref="Stderr"/>
        </Root>
    </Loggers>
</Configuration>
